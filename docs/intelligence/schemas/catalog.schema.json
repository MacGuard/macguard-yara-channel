{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macguard.example/intelligence/catalog/1",
  "title": "MacGuard global catalog",
  "description": "Canonical JSON, signed as a detached blob by the publishing workflow. Pins the exact version and manifest hash of every channel and lists approved combinations.",
  "type": "object",
  "required": ["schema", "catalog", "channels", "combinations", "revocations", "previous"],
  "properties": {
    "schema": {"const": "macguard.catalog/1"},
    "catalog": {"type": "object", "required": ["version", "created_at"], "properties": {"version": {"type": "integer", "minimum": 1}, "created_at": {"type": "string"}}},
    "channels": {"type": "array", "items": {"type": "object", "required": ["id", "family", "version", "state", "publishable", "manifest", "artifacts_root"], "properties": {
      "id": {"type": "string"}, "family": {"type": "string"}, "version": {"type": ["integer", "string"], "description": "integer for new channels; the release tag for the legacy YARA channel"},
      "legacy": {"type": "boolean"}, "state": {"enum": ["draft", "approved", "revoked"]}, "publishable": {"type": "boolean"},
      "manifest": {"type": "object", "required": ["sha256", "bytes"], "properties": {"path": {"type": ["string", "null"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer"}}},
      "artifacts_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "signature_bundle_sha256": {"type": "string"}, "validation_engine": {"type": ["string", "null"]}}}},
    "combinations": {"type": "array", "items": {"type": "object", "required": ["id", "channels"], "properties": {"id": {"type": "string"}, "channels": {"type": "object"}, "state": {"enum": ["draft", "approved", "revoked"]}}}},
    "revocations": {"type": "array", "items": {"type": "object", "required": ["channel", "version", "reason", "at"]}},
    "previous": {"type": "object", "required": ["version", "catalog_sha256"], "properties": {"version": {"type": ["integer", "null"]}, "catalog_sha256": {"type": ["string", "null"]}}},
    "note": {"type": "string"}
  }
}
