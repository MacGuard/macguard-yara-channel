{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macguard.example/intelligence/channel-manifest/1",
  "title": "MacGuard channel manifest",
  "description": "Canonical JSON (sorted keys, no whitespace, integers and strings only). Its SHA-256 is the SHA-256 of that canonical form. Example host in $id is a placeholder; nothing is published there.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "channel", "sources", "artifacts", "artifacts_root", "compatibility", "approval", "validation", "revocation", "previous", "stats"],
  "properties": {
    "schema": {"const": "macguard.channel-manifest/1"},
    "channel": {"type": "object", "required": ["id", "family", "version", "created_at"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "family": {"enum": ["yara", "yara-x", "sigma", "ioc", "clamav", "heuristics", "behavior", "ml", "sandbox"]},
      "version": {"type": "integer", "minimum": 1},
      "created_at": {"type": "string", "format": "date-time"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "redistribution_status"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "upstream_url": {"type": "string"}, "license": {"type": "object"},
      "redistribution_status": {"enum": ["allowed", "allowed-with-conditions", "pending-legal", "blocked", "not-evaluated"]},
      "attribution": {"type": "string"}, "original_signature": {"type": "object"}}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "bytes", "media_type", "origin", "original_signature"], "properties": {
      "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+$"},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0},
      "media_type": {"type": "string"}, "origin": {"enum": ["original", "derived"]},
      "original_signature": {"type": "object", "required": ["present"], "properties": {"present": {"type": "boolean"}, "kind": {"type": "string"}, "verified": {"type": ["boolean", "null"]}}}}}},
    "artifacts_root": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "RFC 6962 Merkle root; leaf = path NUL sha256 (same as the legacy YARA channel)."},
    "compatibility": {"type": "object", "properties": {"platforms": {"type": "array", "items": {"enum": ["macos", "linux"]}}, "engines": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "min_version": {"type": "string"}, "max_version": {"type": "string"}}}}}},
    "approval": {"type": "object", "required": ["state", "publishable", "blocking_reasons"], "properties": {
      "state": {"enum": ["draft", "approved", "revoked"]}, "publishable": {"type": "boolean"}, "blocking_reasons": {"type": "array", "items": {"type": "string"}},
      "approved_by": {"type": "array", "items": {"type": "string"}}, "approved_at": {"type": ["string", "null"]}}},
    "validation": {"type": "object", "properties": {"gates": {"type": "array"}, "attestation": {"type": ["object", "null"], "description": "Signed attestation of tests (design: VALIDATION-PLAN.md). null until it exists."}}},
    "revocation": {"type": "object", "required": ["policy", "revoked"], "properties": {"policy": {"type": "string"}, "revoked": {"type": "boolean"}}},
    "previous": {"type": "object", "required": ["version", "manifest_sha256"], "properties": {"version": {"type": ["integer", "null"]}, "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "stats": {"type": "object"}
  }
}
