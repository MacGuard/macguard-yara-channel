%%{init: {"flowchart": {"wrappingWidth": 300}}}%%
flowchart TB
  f["rule file examined"]:::act
  s["static and dynamic<br/>checks"]:::gate
  a["no finding:<br/>accepted,<br/>VALIDATED"]:::ok
  r["hard criteria:<br/>rejected,<br/>REJECTED"]:::bad
  b["technical finding:<br/>blocked,<br/>QUARANTINED,<br/>not approvable"]:::bad
  f --> s
  s --> a
  s --> r
  s --> b
  a ~~~ r ~~~ b
  classDef act fill:#cfe3ff,stroke:#2f6df0,color:#0b1b33
  classDef gate fill:#ffffff,stroke:#111111,stroke-width:3px,color:#111111
  classDef ok fill:#cdeedd,stroke:#1b6e3c,color:#08210f
  classDef bad fill:#ffd4cc,stroke:#c0392b,color:#33100b
