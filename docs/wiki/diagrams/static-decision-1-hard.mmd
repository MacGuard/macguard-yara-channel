%%{init: {"flowchart": {"wrappingWidth": 300}}}%%
flowchart TB
  f["rule file"]:::act
  h["hard criteria?<br/>binary, empty, no rules,<br/>over 1 MB,<br/>rejected before"]:::chk
  rej["yes:<br/>REJECTED"]:::bad
  t["no: truncated,<br/>corrupt, compile<br/>error?"]:::chk
  qua["yes:<br/>QUARANTINED"]:::bad
  nx["no: continues<br/>in part 2"]:::act
  f --> h
  h --> rej
  h --> t
  t --> qua
  t --> nx
  classDef act fill:#cfe3ff,stroke:#2f6df0,color:#0b1b33
  classDef chk fill:#ffe9b8,stroke:#b8860b,color:#2b1d00
  classDef bad fill:#ffd4cc,stroke:#c0392b,color:#33100b
