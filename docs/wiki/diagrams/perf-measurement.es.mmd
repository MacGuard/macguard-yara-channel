flowchart TB
  C["Corpus pequeño y sintético<br/>y una comprobación canario"]:::src
  K["yarac compila el conjunto<br/>se miden tiempo y memoria"]:::val
  S["yara escanea cada fichero<br/>límite de 10 s por fichero"]:::val
  M["Por proceso: tiempo real,<br/>CPU y memoria máxima"]:::val
  R["Repetir 5 veces: versión<br/>anterior y candidata"]:::val
  V{"¿Mediana por encima del<br/>ruido de la línea base?"}:::gate
  OK["sin regresión"]:::sec
  BAD["regresión: aislar<br/>a los culpables"]:::qua
  NO["No se mide aquí:<br/>Installer Auditor con el<br/>canal real, concurrencia<br/>y condiciones de carrera"]:::qua
  C --> K --> S --> M --> R --> V
  V -->|no| OK
  V -->|sí| BAD
  classDef src fill:#cfe3ff,stroke:#2f6df0,color:#0b1b33
  classDef val fill:#ffe9b8,stroke:#b8860b,color:#2b1d00
  classDef sec fill:#cdeedd,stroke:#1b6e3c,color:#08210f
  classDef qua fill:#ffd4cc,stroke:#c0392b,color:#33100b
  classDef gate fill:#ffffff,stroke:#111111,stroke-width:3px,color:#111111
