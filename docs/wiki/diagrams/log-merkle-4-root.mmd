%%{init: {"flowchart": {"wrappingWidth": 300}}}%%
flowchart BT
  A["node A"]:::val
  B["node B"]:::val
  AB["node AB"]:::val
  C["node C"]:::val
  ROOT["log root"]:::gate
  CP["checkpoint<br/>origin, size, root"]:::sec
