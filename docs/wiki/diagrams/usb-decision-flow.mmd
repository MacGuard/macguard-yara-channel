flowchart TB
  A["USB device plugged in"]:::in --> B["IOKit inventory<br/>and fingerprint"]:::step
  B --> C{"Mac locked?"}:::dec
  C -- "no" --> D["Normal behaviour"]:::ok
  C -- "yes" --> E["Two-stage resolver:<br/>device, then interface"]:::step
  E --> F{"Trusted device<br/>and granted interface?"}:::dec
  F -- "yes" --> G["Allow"]:::ok
  F -- "no" --> H["Deny decision"]:::bad
  H --> I["Endpoint Security AUTH reply<br/>compiles, live use unverified"]:::warn
  H --> J["Reported as OBSERVE ONLY<br/>when enforcement is unproven"]:::warn
  classDef in fill:#1f3a5f,stroke:#8ab4f8,color:#ffffff
  classDef step fill:#2b2b2b,stroke:#bbbbbb,color:#ffffff
  classDef dec fill:#3d3320,stroke:#e0b04a,color:#ffffff
  classDef ok fill:#1e4620,stroke:#6fcf73,color:#ffffff
  classDef bad fill:#5a1f1f,stroke:#ef7b7b,color:#ffffff
  classDef warn fill:#4a3b12,stroke:#e0b04a,color:#ffffff
