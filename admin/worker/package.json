{
  "name": "macguard-quarantine",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "deploy": "python3 ../../scripts/check_worker_config.py --config \"$WRANGLER_CONFIG\" && npx wrangler -c \"$WRANGLER_CONFIG\" deploy",
    "test:runtime": "node --test test-runtime/*.test.mjs",
    "test:ui": "node --no-warnings --test --test-concurrency=1 test/ui/ui.test.mjs",
    "test:ui:search": "node --no-warnings --test --test-concurrency=1 test/ui/search.ui.test.mjs",
    "test:ui:rule": "node --no-warnings --test --test-concurrency=1 test/ui/published_rule.ui.test.mjs",
    "test:ui:restore": "node --no-warnings --test --test-concurrency=1 test/ui/restore.ui.test.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "miniflare": "^4.20260730.0",
    "playwright": "1.64.1"
  }
}
