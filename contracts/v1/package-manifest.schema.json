{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Defensive package manifest",
 "description": "macguard.package-manifest/1. The canonical manifest of ONE defensive package (one family, one engine/format, one version). Its fields files[].path/sha256/bytes, rules_root (same Merkle construction), log{origin,size,root}, status, validation{checked,engine} and evidence keep the exact meaning of the channel manifest written by scripts/seal.py (schema 1). The live YARA release manifest stays schema 1 and is NOT re-signed: the catalogue maps it to this contract (package yara/community) with the same file digests, so existing clients keep verifying what they verify today; new families are sealed directly in this form. The manifest bytes are canonical JSON (sorted keys, no spaces) and are signed with Sigstore (manifest.sigstore.json) and included in the transparency log (inclusion-proof.json): the signature and the proof are separate files, never fields of the manifest they cover. PoC/exploit material is never a family. validation.state says what was really checked: SYNTAX_CHECKED is not 'validated by the engine'. Additive changes keep the number.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "package", "files", "rules_root", "log", "status", "validation", "sources", "stats"],
 "properties": {
  "schema": { "const": "macguard.package-manifest/1" },
  "package": { "type": "object", "additionalProperties": false, "required": ["id", "family", "tier", "name", "version", "created_at", "engine", "format"], "properties": {
   "id": { "type": "string", "pattern": "^package:(yara|sigma|suricata|clamav|ioc|vulnerability-data):[a-z0-9][a-z0-9._-]{0,63}@[A-Za-z0-9._+-]{1,64}$" },
   "family": { "enum": ["yara", "sigma", "suricata", "clamav", "ioc", "vulnerability-data"] },
   "tier": { "enum": ["community", "premium"] },
   "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
   "version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
   "created_at": { "type": "string", "maxLength": 40 },
   "release_tag": { "type": ["string", "null"], "maxLength": 128 },
   "engine": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 64 }, "min_version": { "type": ["string", "null"], "maxLength": 32 }, "syntax_version": { "type": ["string", "null"], "maxLength": 32 } } },
   "format": { "type": "string", "maxLength": 64 },
   "platforms": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 32 } },
   "previous": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["version", "manifest_sha256"], "properties": { "version": { "type": "string", "maxLength": 64 }, "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } ] } } },
  "files": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {
   "path": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/+-]{1,512}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "bytes": { "type": "integer", "minimum": 1 },
   "source": { "type": "string", "maxLength": 128 }, "licence": { "type": "string", "maxLength": 128 } } } },
  "rules_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
  "log": { "type": "object", "additionalProperties": false, "required": ["origin", "size", "root"], "properties": { "origin": { "type": "string", "maxLength": 256 }, "size": { "type": "integer", "minimum": 1 }, "root": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
  "status": { "const": "PUBLISHED" },
  "validation": { "type": "object", "additionalProperties": false, "required": ["state", "engine", "checked"], "properties": {
   "state": { "enum": ["SYNTAX_CHECKED", "ENGINE_COMPILED", "ENGINE_TESTED"] }, "engine": { "type": "string", "maxLength": 128 }, "checked": { "type": "integer", "minimum": 1 } } },
  "sources": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["id", "licence"], "properties": {
   "id": { "type": "string", "maxLength": 128 }, "licence": { "type": "string", "maxLength": 128 }, "url": { "type": "string", "maxLength": 512 }, "commit": { "type": "string", "maxLength": 64 } } } },
  "stats": { "type": "object", "additionalProperties": false, "required": ["files", "items", "expanded_bytes"], "properties": { "files": { "type": "integer", "minimum": 1 }, "items": { "type": "integer", "minimum": 1 }, "expanded_bytes": { "type": "integer", "minimum": 1 } } },
  "related_vulnerabilities": { "type": "array", "maxItems": 10000, "items": { "type": "string", "maxLength": 64 } },
  "changes": { "type": "object", "additionalProperties": false, "properties": { "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "modified": { "type": "integer", "minimum": 0 } } },
  "evidence": { "type": "object", "description": "As in seal.py (dynamic, dynamic_corpus... may be present).", "properties": { "candidate_run_id": { "type": "string", "maxLength": 64 }, "candidate_workflow_sha": { "type": "string", "maxLength": 64 }, "publish_run_url": { "type": "string", "maxLength": 512 } } }
 }
}
